# Copy to .env.local. Never commit real credentials.
# Database-backed operations require a dedicated database or a least-privilege role.
DATABASE_URL=

# Missing ADMIN_KEY denies all admin pages/APIs. Use a local development value.
ADMIN_KEY=

# Gated automation writes remain disabled until explicitly configured.
AGENT_WRITE_ENABLED=false

# Missing salt omits session hashes from click records.
CLICK_HASH_SALT=

# Optional reports; missing webhook logs locally.
DISCORD_WEBHOOK_URL=

# Production cron requires Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Public URL used when composing absolute recommendation URLs.
NEXT_PUBLIC_SITE_URL=

# Optional OpenAI classification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional optimizer, on a local/other Node host with the Claude runtime.
# Configure one of the two authentication methods, not both.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Public sample workspace only; use a random secret of at least 32 characters.
# No database or AI credentials are needed for /demo. Development has a local-only fallback.
DEMO_SESSION_SECRET=
