# 複製成 .env.local 並填值。缺任何一項 → 對應功能 graceful no-op（不爆）。

# ── 資料庫（Neon Postgres）──
# 建議：與主站 tbtitest.com 共用「同一個 Neon」，但給本服務一個「限權角色」：
#   affiliate_* 資料表可讀寫；正式站 user/auth 表不可寫；只讀匿名聚合 View。
# 未設定 → 所有 DB 功能停用，後台仍可開、商品卡 / 點擊不寫入。
DATABASE_URL=

# ── 後台密碼閘 ──
# /admin 與 /api/admin/* 需 ?key=<這個值>（比照主站 /admin/answers 的 ADMIN_KEY 模式）。
# 沒設 → 後台與管理 API 永遠 403（預設安全）。本機隨便設一個。
ADMIN_KEY=

# ── Kill switch（規格 §52）──
# false / 未設 → Agent 進入「唯讀 + 只報告」模式：不自動改商品、不自動換連結。
# 必須明確設 true 才允許寫入型自動化（匯入、狀態變更、產生連結）。
AGENT_WRITE_ENABLED=false

# ── 點擊隱私雜湊鹽 ──
# 用來把 session/cookie 值雜湊化後才存進 affiliate_clicks（不存原始值、不存 IP/email）。
# 換鹽即「忘記」舊雜湊關聯。沒設 → 不寫 session 雜湊欄位。
CLICK_HASH_SALT=

# ── Discord 通知 ──
# Webhook URL；未設 → 日報 / 警報只寫 console，不外送。
DISCORD_WEBHOOK_URL=

# ── 排程保護 ──
# /api/cron/* 需 header  Authorization: Bearer <CRON_SECRET>（Vercel Cron 設同值）。
# 沒設 → cron 路由在 production 一律 403；dev 放行方便測試。
CRON_SECRET=

# ── 對外網域 ──
# 用來組 /go/<code> 絕對網址（給主站商品卡 CTA）。本機可不填。
NEXT_PUBLIC_SITE_URL=

# ── V2（AI 自動分類）──
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── V3（Claude Agent SDK「優化大腦」）──
# 二擇一：一般 API key（sk-ant-api03-）或 Claude OAuth token（sk-ant-oat01-，由 `claude setup-token` 取得）
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_MODEL=claude-sonnet-4-6
